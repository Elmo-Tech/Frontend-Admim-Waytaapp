{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@/*": [
        "../src/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.spec.ts"
  ]
}
